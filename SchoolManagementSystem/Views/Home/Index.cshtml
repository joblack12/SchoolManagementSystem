@model SchoolManagementSystem.Models.HomeViewModel


@{
    ViewData["Title"] = "Home Page";
}

<!-- banner section -->
<section id="home" class="w3l-banner py-5">
    <div class="banner-content">
        <div class="container py-4">
            <div class="row align-items-center pt-sm-5 pt-4">
                <div class="col-md-6">
                    <h3 class="mb-lg-4 mb-3">Shape The Future Through <span class="d-block">Innovation and Knowledge</span></h3>
                    <p class="banner-sub">Master the Skills that Define Tomorrow, Smart Learning for a Digital World.</p>
                    <div class="d-flex align-items-center buttons-banner">
                        <a href="contact.html" class="btn btn-style mt-lg-5 mt-4 disabled">Join Ridgesview Schools</a>
                    </div>
                </div>
                <div class="col-md-6 right-banner-2 text-end position-relative mt-md-0 mt-5">
                    <div class="sub-banner-image mx-auto">
                        <img src="~/images/banner.png" asp-append-version="true" class="img-fluid position-relative" alt="Ridgesview Schools Banner">
                    </div>
                    <div class="banner-style-1 position-absolute">
                        <div class="banner-style-2 position-relative">
                            <h4>Skill up. Stand out.</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- //banner section -->
<!-- home 4grids block -->
<section class="services-w3l-block py-5" id="features">
    <div class="container py-md-5 py-4">
        <div class="title-main text-center mx-auto mb-md-5 mb-4" style="max-width:500px;">
            <p class="text-uppercase">Key Features</p>
            <h3 class="title-style">Achieve Your Creative Potential With Ridgesview Schools</h3>
        </div>
        <div class="row">
            <div class="col-md-6 col-lg-3 d-flex align-items-stretch">
                <div class="icon-box icon-box-clr-1">
                    <div class="icon"><i class="fas fa-palette"></i></div>
                    <h4 class="title"><a href="#about">Creative Mentors</a></h4>
                    <p>Bridge the gap between theory and practice by learning directly from seasoned tech professionals.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex align-items-stretch mt-md-0 mt-4">
                <div class="icon-box icon-box-clr-2">
                    <div class="icon"><i class="fas fa-laptop-code"></i></div>
                    <h4 class="title"><a href="#about">Hands-On Learning</a></h4>
                    <p>Transform theory into concrete proof of your skills with hands-on projects designed around real-world industry scenarios.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex align-items-stretch mt-lg-0 mt-4">
                <div class="icon-box icon-box-clr-3">
                    <div class="icon"><i class="fas fa-headset"></i></div>
                    <h4 class="title"><a href="#about">Ongoing Support</a></h4>
                    <p>Accelerate your career with dedicated mentorship, strategic job guidance, and a global network of peers.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex align-items-stretch mt-lg-0 mt-4">
                <div class="icon-box icon-box-clr-4">
                    <div class="icon"><i class="fas fa-award"></i></div>
                    <h4 class="title"><a href="#about">Exclusive Certifications</a></h4>
                    <p>Turn your hard work into career equity with verifiable credentials trusted by leading tech companies worldwide.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- home 4grids block -->
<!-- home image with content block -->
<section class="w3l-servicesblock pt-lg-5 pt-4 pb-5 mb-lg-5" id="about">
    <div class="container pb-md-5 pb-4">
        <div class="row pb-xl-5 align-items-center">
            <div class="col-lg-6 position-relative home-block-3-left pb-lg-0 pb-5">
                <div class="position-relative">
                    <img src="~/images/img1.jpg" asp-append-version="true" alt="" class="img-fluid radius-image">
                </div>
                <div class="imginfo__box">
                    <h6 class="imginfo__title">Join Ridgesview Schools Today!</h6>
                    <p>Ignite your imagination through tailored guidance<br>and hands-on mastery.</p>
                    <a href="tel:http://1(800)7654321"><i class="fas fa-phone-alt"></i> (+254)-711117784</a>
                </div>
            </div>
            <div class="col-xl-5 col-lg-6 offset-xl-1 mt-lg-0 mt-5 pt-lg-0 pt-5">
                <h3 class="title-style">Why Choose Ridgesview Schools?</h3>
                <p class="mt-4">At Ridgesview Schools, we transform aspiring designers and developers into future industry leaders through cutting-edge curriculum, real-world projects, and a powerful creative ecosystem.</p>
                <ul class="mt-4 list-style-lis pt-lg-1">
                    <li><i class="fas fa-check-circle"></i>Programming Courses And Tailored Design </li>
                    <li><i class="fas fa-check-circle"></i>Access to 100K+ Online Resources</li>
                    <li><i class="fas fa-check-circle"></i>Certification which are Industry-Recognized</li>
                </ul>
                <a href="contact.html" class="btn btn-style mt-5 disabled">Apply Now</a>

            </div>
        </div>
    </div>
</section>
<!-- //home image with content block -->
<!-- courses section -->
<div class="w3l-grids-block-5 home-course-bg py-5" id="courses">
    <div class="container py-md-5 py-4">
        <div class="title-main text-center mx-auto mb-md-5 mb-4" style="max-width:500px;">
            <p class="text-uppercase">Best Courses</p>
            <h3 class="title-style">Find The Right Course For You</h3>
        </div>
        <div class="row justify-content-center">
            @if (Model.Courses != null && Model.Courses.Any())
            {
                foreach (var course in Model.Courses)
                {
                    <div class="col-lg-4 col-md-6 mt-4">
                        <div class="coursecard-single">
                            <div class="grids5-info position-relative">
                                <img src="@Url.Content("~/images/classrom.jpg")" alt="Course Image" class="img-fluid" />
                                <div class="meta-list">
                                    <span class="text-muted">@course.Name</span>
                                </div>
                            </div>
                            <div class="content-main-top">
                                <div class="content-top mb-4 mt-3">
                                    <ul class="list-unstyled d-flex align-items-center justify-content-between">
                                        <li><i class="fas fa-clock"></i> @course.Duration weeks</li>
                                    </ul>
                                </div>
                                <h4><span class="text-muted">@course.Name</span></h4>
                                <p>@course.Description</p>
                                <div class="top-content-border d-flex align-items-center justify-content-between mt-4 pt-4">
                                    <h6>Free</h6>
                                    <span class="btn btn-style-primary disabled">Know Details <i class="fas fa-arrow-right"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No courses available at the moment.</p>
            }
        </div>
        <div class="text-center mt-sm-5 mt-4 pt-sm-0 pt-1">
            <span class="btn btn-style btn-style-secondary disabled mt-sm-3">
                Browse more courses
            </span>
        </div>
    </div>
</div>
<!-- //courses section -->
<!-- classes and subjects section -->
<div class="w3l-grids-block-5 home-course-bg py-5" id="classes">
    <div class="container py-md-5 py-4">
        <div class="title-main text-center mx-auto mb-md-5 mb-4" style="max-width:500px;">
            <p class="text-uppercase">School Classes</p>
            <h3 class="title-style">Find The Classes and Their Subjects</h3>
        </div>
        <div class="row justify-content-center">
            @if (Model.SchoolClasses != null && Model.SchoolClasses.Any())
            {
                foreach (var schoolClass in Model.SchoolClasses)
                {
                    <div class="col-lg-4 col-md-6 mt-4">
                        <div class="coursecard-single">
                            <div class="grids5-info position-relative">
                                <img src="@Url.Content("~/images/subjects.jpg")" alt="Class Image" class="img-fluid scale-animation" />
                                <div class="meta-list">
                                    <span class="text-muted">@schoolClass.ClassName</span>
                                </div>
                            </div>
                            <div class="content-main-top">
                                <div class="content-top mb-4 mt-3">
                                    <ul class="list-unstyled d-flex align-items-center justify-content-between">
                                        <li><i class="fas fa-calendar-alt"></i> Start: @schoolClass.StartDate?.ToString("dd/MM/yyyy")</li>
                                        <li><i class="fas fa-calendar-check"></i> End: @schoolClass.EndDate?.ToString("dd/MM/yyyy")</li>
                                    </ul>
                                </div>
                                <h4><span class="text-muted">@schoolClass.ClassName</span></h4>
                                <p>Subjects:</p>
                                <ul>
                                    @foreach (var subject in schoolClass.Subjects)
                                    {
                                        <li>@subject</li>
                                    }
                                </ul>
                                <div class="top-content-border d-flex align-items-center justify-content-between mt-4 pt-4">
                                    <h6>Active</h6>
                                    <span class="btn btn-style-primary disabled">Class Details <i class="fas fa-arrow-right"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No school classes available at the moment.</p>
            }
        </div>
        <div class="text-center mt-sm-5 mt-4 pt-sm-0 pt-1">
            <span class="btn btn-style btn-style-secondary disabled mt-sm-3">
                Browse more classes
            </span>
        </div>
    </div>
</div>
<!-- //classes and subjects section -->
<!-- why choose block -->
<section class="w3l-service-1 py-5">
    <div class="container py-md-5 py-4">
        <div class="title-main text-center mx-auto mb-md-5 mb-4" style="max-width:500px;">
            <p class="text-uppercase">Why Choose Us</p>
            <h3 class="title-style">Launch Your Career in Tech and Design</h3>
        </div>
        <div class="row content23-col-2 text-center">
            <div class="col-md-6">
                <div class="content23-grid content23-grid1">
