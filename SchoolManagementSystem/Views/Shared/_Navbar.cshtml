<nav class="navbar navbar-expand-lg navbar-light">
    <a class="navbar-brand"
       asp-area=""
       asp-controller="Home"
       asp-action="Index">
        <img src="~/images/logo.png"
             alt="Ridgesview Schools Logo"
             style="height: 125px;" />
        Ridgesview Schools
    </a>

    <button class="navbar-toggler collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarScroll"
            aria-controls="navbarScroll"
            aria-expanded="false"
            aria-label="Toggle navigation">
        <span class="navbar-toggler-icon fa icon-expand fa-bars"></span>
        <span class="navbar-toggler-icon fa icon-close fa-times"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarScroll">
        <ul class="navbar-nav ms-auto my-2 my-lg-0 navbar-nav-scroll">
            <li class="nav-item">
                <a class="nav-link"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>
            </li>

            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Dashboard"
                           asp-action="AdminDashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        @await Component.InvokeAsync("Notifications")
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Register">
                            Register Member
                        </a>
                    </li>

            }
            else if (User.IsInRole("Employee"))
            {
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Dashboard"
                       asp-action="EmployeeDashboard">
                        Dashboard
                    </a>
                </li>
            }
            else if (User.IsInRole("Teacher"))
            {
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Dashboard"
                       asp-action="TeacherDashboard">
                        Dashboard
                    </a>
                </li>
            }
            else if (User.IsInRole("Student"))
            {
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Dashboard"
                       asp-action="StudentDashboard">
                        Dashboard
                    </a>
                </li>
            }

            <!-- System Alerts Bell Badge -->
            @await Component.InvokeAsync("AlertBell")

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle"
                   href="#"
                   id="navbarAccount"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    Account
                </a>

                <ul class="dropdown-menu" aria-labelledby="navbarAccount">
                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="ChangeUser">
                            Profile
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="ChangePassword">
                            Change Password
                        </a>
                    </li>
                    <li>
                        <form asp-area=""
                              asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            <button type="submit"
                                    class="dropdown-item">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        }
            else
        {
            <li class="nav-item">
                <a class="nav-link"
                   asp-area=""
                   asp-controller="Account"
                   asp-action="Register">
                    Register
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   asp-area=""
                   asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>
            </li>
        }
    </ul>
</div>
</nav>
