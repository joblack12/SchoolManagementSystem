<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolManagementSystem</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <!-- CSS Global para Navbar e Footer -->
    <link rel="stylesheet" href="~/css/style-starter.css" asp-append-version="true" />
    <!-- CSS Específico para as Views de Conta -->
    <link rel="stylesheet" href="~/css/style-account.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link href="https://googleapis.com" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cloudflare.com" />
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body class="form-account-background">
    <!-- Navbar -->
    <partial name="_Navbar" />

    <!-- Main Content -->
    <main class="form-account-padding">
        @RenderBody()
    </main>

    <!-- Footer -->
    <partial name="_Footer" />

    <!-- JS Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="https://jsdelivr.net"></script>
    <script src="https://syncfusion.com"></script>
    @RenderSection("Scripts", required: false)
    <ejs-scripts></ejs-scripts>
</body>
</html>
