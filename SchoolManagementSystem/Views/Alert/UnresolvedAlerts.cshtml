@{
    Layout = "_Dashboard";
    ViewBag.PageTitle = "Alerts";
    ViewBag.SubPageTitle = "Unresolved Alerts";
}

@model IEnumerable<SchoolManagementSystem.Data.Entities.Alert>

<h2>Unresolved Alerts</h2>

@Html.AntiForgeryToken()

<table class="table">
    <thead>
        <tr>
            <th>Message</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var alert in Model)
        {
            <tr>
                <td>@alert.Message</td>
                <td>@alert.CreatedAt</td>
                <td>
                    <button class="btn btn-success" onclick="markAsResolved(@alert.Id)">Mark as Resolved</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://jsdelivr.net"></script>
    <script>
        function markAsResolved(alertId = 0) {
            const swal = Reflect.get(window, 'Swal');

            swal.fire({
                title: 'Are you sure?',
                text: "You want to mark this alert as resolved!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, resolve it!',
                cancelButtonText: 'No, cancel!'
            }).then(function (result = { isConfirmed: false }) {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("MarkAsResolved", "Alert")',
                        type: 'POST',
                        data: {
                            id: alertId,
                            __RequestVerificationToken: token
                        },
                        success: function () {
                            swal.fire(
                                'Resolved!',
                                'The alert has been marked as resolved.',
                                'success'
                            ).then(function () {
                                location.reload();
                            });
                        },
                        error: function () {
                            swal.fire(
                                'Error!',
                                'There was a problem resolving the alert.',
                                'error'
                            );
                        }
                    });
                }
            });
        }
    </script>
}



