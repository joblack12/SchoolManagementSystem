@model IEnumerable<SchoolManagementSystem.Models.StudentGradeAverageViewModel>

@{
    Layout = "_Dashboard";
    ViewBag.PageTitle = "Grades";
    ViewBag.SubPageTitle = "List";
}

<h2>Grades List</h2>

<form id="filterGradesClassForm" asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group">
        <label for="SchoolClassId" class="mr-2">Select Class:</label>
        <select id="SchoolClassId" name="classId" class="form-control mr-2">
            <option value="">-- Select Class --</option>
            @foreach (var schoolClass in ViewBag.Classes)
            {
                <option value="@schoolClass.Value" selected="@(Context.Request.Query["classId"] == schoolClass.Value ? "selected" : null)">
                    @schoolClass.Text
                </option>
            }
        </select>
        <input type="submit" value="Filter" class="btn btn-primary" />
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Student</th>
                <th>Average Grade</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Student.FirstName @item.Student.LastName</td>
                    <td>@item.AverageGrade.ToString("F2")</td>
                    <td>@item.Status</td>
                    <td>
                        <a class="btn btn-info btn-sm" asp-action="Details" asp-route-studentId="@item.Student.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Please select a class to see the students and their grades.</div>
}

@section Scripts {
    <script>
        document.getElementById("SchoolClassId")?.addEventListener("change", function () {
            document.forms.namedItem("filterGradesClassForm")?.submit();
        });
    </script>
}
