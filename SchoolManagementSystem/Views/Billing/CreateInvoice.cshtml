@model SchoolManagementSystem.Data.Entities.FeeInvoice
@{
    ViewData["Title"] = "Issue Fee Invoice";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
    var defaultDueDate = (Model?.DueDate == default || Model?.DueDate == null)
        ? DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")
        : Model.DueDate.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>Issue New Fee Invoice</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateInvoice" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="StudentId" class="form-label fw-semibold">Select Student</label>
                            <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select" required>
                                <option value="">-- Choose a Student --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Invoice Description</label>
                            <input asp-for="Title" class="form-control" maxlength="100" placeholder="e.g., Term 1 Tuition, Lab & Library Fees" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TotalAmount" class="form-label fw-semibold">Amount (KES)</label>
                                <input asp-for="TotalAmount" type="number" step="0.01" min="1" class="form-control" required />
                                <span asp-validation-for="TotalAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DueDate" class="form-label fw-semibold">Due Date</label>
                                <input asp-for="DueDate" type="date" value="@defaultDueDate" class="form-control" required />
                                <span asp-validation-for="DueDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-1"></i> Create Invoice
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
